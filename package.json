    "test:watch": "vitest"
  },
  "dependencies": {
    "@wxt-dev/module-react": "^1.1.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wxt": "^0.20.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
